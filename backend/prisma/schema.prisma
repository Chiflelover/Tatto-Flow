generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

enum TattooSize {
  SMALL
  MEDIUM
  LARGE

  @@map("tattoo_size")
}

enum DetailLevel {
  LIGHT
  MEDIUM
  DETAILED

  @@map("detail_level")
}

enum ConversationStatus {
  ACTIVE
  ABANDONED
  COMPLETED

  @@map("conversation_status")
}

enum ConversationState {
  START
  ASK_SIZE
  ASK_DETAIL
  ASK_BODY_PART
  WAITING_IMAGE
  ANALYZING
  VALIDATING
  HANDOFF_TO_TATTOO_ARTIST

  @@map("conversation_state")
}

enum LeadStatus {
  ANALYZING
  VERIFIED
  REQUIRES_REVIEW
  HANDOFF_TO_TATTOO_ARTIST
  COMPLETED

  @@map("lead_status")
}

enum ReadinessStatus {
  LISTO
  REVISAR
  INCOMPLETO

  @@map("readiness_status")
}

enum ReviewReason {
  SIZE_MISMATCH
  DETAIL_MISMATCH
  LOW_SIZE_CONFIDENCE
  LOW_DETAIL_CONFIDENCE
  AI_ERROR
  PRICING_RULE_NOT_FOUND
  NOT_ON_SKIN

  @@map("review_reason")
}

model User {
  id             String               @id @default(uuid()) @db.Uuid
  email          String               @unique @db.VarChar(320)
  passwordHash   String               @map("password_hash") @db.VarChar(255)
  createdAt      DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime             @updatedAt @map("updated_at") @db.Timestamptz(3)
  pricingChanges PricingRuleHistory[]
  sessions       AuthSession[]

  @@map("users")
}

model AuthSession {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  tokenHash String   @unique @map("token_hash") @db.Char(64)
  expiresAt DateTime @map("expires_at") @db.Timestamptz(3)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("auth_sessions")
}

model Customer {
  id                      String         @id @default(uuid()) @db.Uuid
  phoneNumber             String         @unique @map("phone_number") @db.VarChar(20)
  lastOutOfHoursNoticeKey String?        @map("last_out_of_hours_notice_key") @db.VarChar(10)
  createdAt               DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt               DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)
  conversations           Conversation[]
  leads                   Lead[]

  @@map("customers")
}

model Conversation {
  id             String             @id @default(uuid()) @db.Uuid
  customerId     String             @map("customer_id") @db.Uuid
  currentState   ConversationState  @default(START) @map("current_state")
  status         ConversationStatus @default(ACTIVE)
  selectedSize   TattooSize?        @map("selected_size")
  selectedDetail DetailLevel?       @map("selected_detail")
  bodyPart       String?            @map("body_part") @db.VarChar(10)
  lastActivityAt DateTime           @default(now()) @map("last_activity_at") @db.Timestamptz(3)
  createdAt      DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)
  customer       Customer           @relation(fields: [customerId], references: [id], onDelete: Cascade)
  lead           Lead?

  @@index([customerId])
  @@index([status, lastActivityAt])
  @@map("conversations")
}

/// Represents a quotation candidate. Incomplete candidates are preserved when
/// their conversation is abandoned and are classified by LeadEvaluation.
model Lead {
  id                 String          @id @default(uuid()) @db.Uuid
  customerId         String          @map("customer_id") @db.Uuid
  conversationId     String?         @unique @map("conversation_id") @db.Uuid
  selectedSize       TattooSize?     @map("selected_size")
  selectedDetail     DetailLevel?    @map("selected_detail")
  bodyPart           String?         @map("body_part") @db.VarChar(10)
  status             LeadStatus      @default(ANALYZING)
  reviewReasons      ReviewReason[]  @default([]) @map("review_reasons")
  calculatedMinPrice Decimal?        @map("calculated_min_price") @db.Decimal(10, 2)
  calculatedMaxPrice Decimal?        @map("calculated_max_price") @db.Decimal(10, 2)
  pricingRuleId      String?         @map("pricing_rule_id") @db.Uuid
  pricingRuleVersion Int?            @map("pricing_rule_version")
  priceSentAt        DateTime?       @map("price_sent_at") @db.Timestamptz(3)
  archivedAt         DateTime?       @map("archived_at") @db.Timestamptz(3)
  createdAt          DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)
  customer           Customer        @relation(fields: [customerId], references: [id], onDelete: Restrict)
  conversation       Conversation?   @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  pricingRule        PricingRule?    @relation(fields: [pricingRuleId], references: [id], onDelete: Restrict)
  images             LeadImage[]
  aiAnalysis         AiAnalysis?
  evaluation         LeadEvaluation?

  @@index([customerId])
  @@index([status, createdAt])
  @@index([pricingRuleId])
  @@index([archivedAt])
  @@map("leads")
}

model LeadEvaluation {
  id               String          @id @default(uuid()) @db.Uuid
  leadId           String          @unique @map("lead_id") @db.Uuid
  rawScore         Int             @map("raw_score")
  maxPositiveScore Int             @map("max_positive_score")
  readinessScore   Decimal         @map("readiness_score") @db.Decimal(5, 2)
  readinessStatus  ReadinessStatus @map("readiness_status")
  rulesVersion     Int             @map("rules_version")
  contributions    Json            @db.JsonB
  blockers         Json            @db.JsonB
  evaluatedAt      DateTime        @default(now()) @map("evaluated_at") @db.Timestamptz(3)
  updatedAt        DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)
  lead             Lead            @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@map("lead_evaluations")
}

model LeadImage {
  id          String    @id @default(uuid()) @db.Uuid
  leadId      String    @map("lead_id") @db.Uuid
  storagePath String    @map("storage_path") @db.Text
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  expiresAt   DateTime  @map("expires_at") @db.Timestamptz(3)
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(3)
  lead        Lead      @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId])
  @@index([expiresAt, deletedAt])
  @@map("lead_images")
}

model AiAnalysis {
  id               String      @id @default(uuid()) @db.Uuid
  leadId           String      @unique @map("lead_id") @db.Uuid
  detectedSize     TattooSize  @map("detected_size")
  sizeConfidence   Decimal     @map("size_confidence") @db.Decimal(4, 3)
  detectedDetail   DetailLevel @map("detected_detail")
  detailConfidence Decimal     @map("detail_confidence") @db.Decimal(4, 3)
  rawResponse      Json?       @map("raw_response") @db.JsonB
  createdAt        DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  lead             Lead        @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@map("ai_analyses")
}

model PricingRule {
  id        String               @id @default(uuid()) @db.Uuid
  size      TattooSize
  detail    DetailLevel
  minPrice  Decimal              @map("min_price") @db.Decimal(10, 2)
  maxPrice  Decimal              @map("max_price") @db.Decimal(10, 2)
  isActive  Boolean              @default(true) @map("is_active")
  version   Int                  @default(1)
  updatedAt DateTime             @updatedAt @map("updated_at") @db.Timestamptz(3)
  leads     Lead[]
  history   PricingRuleHistory[]

  @@unique([size, detail])
  @@index([isActive])
  @@map("pricing_rules")
}

model PricingRuleHistory {
  id              String      @id @default(uuid()) @db.Uuid
  pricingRuleId   String      @map("pricing_rule_id") @db.Uuid
  oldMinPrice     Decimal     @map("old_min_price") @db.Decimal(10, 2)
  oldMaxPrice     Decimal     @map("old_max_price") @db.Decimal(10, 2)
  newMinPrice     Decimal     @map("new_min_price") @db.Decimal(10, 2)
  newMaxPrice     Decimal     @map("new_max_price") @db.Decimal(10, 2)
  changedByUserId String      @map("changed_by_user_id") @db.Uuid
  changedAt       DateTime    @default(now()) @map("changed_at") @db.Timestamptz(3)
  pricingRule     PricingRule @relation(fields: [pricingRuleId], references: [id], onDelete: Restrict)
  changedByUser   User        @relation(fields: [changedByUserId], references: [id], onDelete: Restrict)

  @@index([pricingRuleId, changedAt])
  @@index([changedByUserId])
  @@map("pricing_rule_history")
}

model WhatsAppInboundMessage {
  messageId  String   @id @map("message_id") @db.VarChar(255)
  receivedAt DateTime @default(now()) @map("received_at") @db.Timestamptz(3)

  @@index([receivedAt])
  @@map("whatsapp_inbound_messages")
}
