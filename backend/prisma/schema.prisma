generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  TATTOO_ARTIST

  @@map("user_role")
}

enum FlowVersion {
  V1
  V2

  @@map("flow_version")
}

enum AnalysisVersion {
  V1
  V2

  @@map("analysis_version")
}

enum ScaleReferenceType {
  EXPLICIT_REFERENCE
  BODY_CONTEXT
  NONE

  @@map("scale_reference_type")
}

enum CalibrationCaseType {
  AREA
  COLOR

  @@map("calibration_case_type")
}

enum PricingModelStatus {
  DRAFT
  ACTIVE
  SUPERSEDED

  @@map("pricing_model_status")
}

enum TattooSize {
  SMALL
  MEDIUM
  LARGE

  @@map("tattoo_size")
}

enum DetailLevel {
  LIGHT
  MEDIUM
  DETAILED

  @@map("detail_level")
}

enum ConversationStatus {
  ACTIVE
  ABANDONED
  COMPLETED

  @@map("conversation_status")
}

enum ConversationState {
  START
  ASK_SIZE
  ASK_DETAIL
  ASK_BODY_PART
  WAITING_IMAGE
  ANALYZING
  VALIDATING
  HANDOFF_TO_TATTOO_ARTIST
  ASK_FIRST_TATTOO
  ASK_SAME_SIZE
  ASK_DESIRED_SIZE_CM
  ASK_COLOR
  READY_FOR_ANALYSIS
  READY_FOR_PRICING
  HUMAN_REVIEW
  SPECIAL_REVIEW
  PRICE_READY
  ASK_ADVANCE_INTENT

  @@map("conversation_state")
}

enum ColorDeclaration {
  BLACK_ONLY
  BLACK_WITH_SOME_COLOR
  MOSTLY_COLOR

  @@map("color_declaration")
}

enum LeadStatus {
  ANALYZING
  VERIFIED
  REQUIRES_REVIEW
  HANDOFF_TO_TATTOO_ARTIST
  COMPLETED
  AUTO_QUOTED
  SPECIAL_REVIEW
  READY_TO_COORDINATE

  @@map("lead_status")
}

enum BookingIntent {
  DIRECT_BOOKING
  ARTIST_CONTACT

  @@map("booking_intent")
}

enum ReadinessStatus {
  LISTO
  REVISAR
  INCOMPLETO

  @@map("readiness_status")
}

enum ReviewReason {
  SIZE_MISMATCH
  DETAIL_MISMATCH
  LOW_SIZE_CONFIDENCE
  LOW_DETAIL_CONFIDENCE
  AI_ERROR
  PRICING_RULE_NOT_FOUND
  NOT_ON_SKIN

  @@map("review_reason")
}

model User {
  id             String               @id @default(uuid()) @db.Uuid
  email          String               @unique @db.VarChar(320)
  passwordHash   String               @map("password_hash") @db.VarChar(255)
  role           UserRole             @default(TATTOO_ARTIST)
  accountId      String?              @unique @map("account_id") @db.Uuid
  createdAt      DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime             @updatedAt @map("updated_at") @db.Timestamptz(3)
  pricingChanges PricingRuleHistory[]
  sessions       AuthSession[]
  deletedImages  LeadImage[]          @relation("DeletedLeadImages")
  account        TattooArtistAccount? @relation(fields: [accountId], references: [id], onDelete: Restrict)

  @@map("users")
}

model TattooArtistAccount {
  id                String                @id @default(uuid()) @db.Uuid
  name              String                @db.VarChar(120)
  isActive          Boolean               @default(true) @map("is_active")
  createdAt         DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime              @updatedAt @map("updated_at") @db.Timestamptz(3)
  user              User?
  channel           WhatsAppChannel?
  customers         Customer[]
  conversations     Conversation[]
  leads             Lead[]
  pricingRules      PricingRule[]
  artistStyles      ArtistStyle[]
  modelVersions     PricingModelVersion[]
  adjustmentPercent Decimal               @default(0) @map("adjustment_percent") @db.Decimal(7, 2)
  quotes            Quote[]

  @@map("tattoo_artist_accounts")
}

model TattooStyle {
  id            String                @id @default(uuid()) @db.Uuid
  code          String                @unique @db.VarChar(64)
  name          String                @db.VarChar(120)
  isActive      Boolean               @default(true) @map("is_active")
  artistStyles  ArtistStyle[]
  cases         CalibrationCase[]
  modelVersions PricingModelVersion[]

  @@map("tattoo_styles")
}

model ArtistStyle {
  accountId String              @map("account_id") @db.Uuid
  styleId   String              @map("style_id") @db.Uuid
  isEnabled Boolean             @default(true) @map("is_enabled")
  account   TattooArtistAccount @relation(fields: [accountId], references: [id], onDelete: Restrict)
  style     TattooStyle         @relation(fields: [styleId], references: [id], onDelete: Restrict)

  @@id([accountId, styleId])
  @@map("artist_styles")
}

model CalibrationCase {
  id            String              @id @default(uuid()) @db.Uuid
  styleId       String              @map("style_id") @db.Uuid
  imageUrl      String              @map("image_url") @db.Text
  type          CalibrationCaseType
  areaCm2       Decimal             @map("area_cm2") @db.Decimal(12, 2)
  colorCoverage Decimal             @map("color_coverage") @db.Decimal(4, 3)
  displayOrder  Int                 @map("display_order")
  isActive      Boolean             @default(true) @map("is_active")
  style         TattooStyle         @relation(fields: [styleId], references: [id], onDelete: Restrict)
  answers       CalibrationAnswer[]

  @@index([styleId, isActive, displayOrder])
  @@map("calibration_cases")
}

model PricingModelVersion {
  id                String                @id @default(uuid()) @db.Uuid
  accountId         String                @map("account_id") @db.Uuid
  styleId           String                @map("style_id") @db.Uuid
  version           Int
  status            PricingModelStatus    @default(DRAFT)
  caseSnapshot      Json                  @map("case_snapshot") @db.JsonB
  modelParameters   Json?                 @map("model_parameters") @db.JsonB
  algorithmVersion  String                @default("AREA_COLOR_SEPARABLE_V1") @map("algorithm_version") @db.VarChar(64)
  adjustmentPercent Decimal               @default(0) @map("adjustment_percent") @db.Decimal(7, 2)
  sourceVersionId   String?               @map("source_version_id") @db.Uuid
  createdAt         DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  activatedAt       DateTime?             @map("activated_at") @db.Timestamptz(3)
  account           TattooArtistAccount   @relation(fields: [accountId], references: [id], onDelete: Restrict)
  style             TattooStyle           @relation(fields: [styleId], references: [id], onDelete: Restrict)
  sourceVersion     PricingModelVersion?  @relation("ModelSource", fields: [sourceVersionId], references: [id], onDelete: Restrict)
  derivedVersions   PricingModelVersion[] @relation("ModelSource")
  answers           CalibrationAnswer[]
  quotes            Quote[]

  @@unique([accountId, styleId, version])
  @@unique([id, accountId])
  @@index([accountId, styleId, status])
  @@map("pricing_model_versions")
}

model CalibrationAnswer {
  id              String              @id @default(uuid()) @db.Uuid
  modelVersionId  String              @map("model_version_id") @db.Uuid
  caseId          String              @map("case_id") @db.Uuid
  pricePen        Decimal             @map("price_pen") @db.Decimal(12, 2)
  modelVersion    PricingModelVersion @relation(fields: [modelVersionId], references: [id], onDelete: Restrict)
  calibrationCase CalibrationCase     @relation(fields: [caseId], references: [id], onDelete: Restrict)

  @@unique([modelVersionId, caseId])
  @@map("calibration_answers")
}

model WhatsAppChannel {
  id            String              @id @default(uuid()) @db.Uuid
  accountId     String              @unique @map("account_id") @db.Uuid
  phoneNumber   String              @unique @map("phone_number") @db.VarChar(20)
  phoneNumberId String              @unique @map("phone_number_id") @db.VarChar(64)
  createdAt     DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)
  account       TattooArtistAccount @relation(fields: [accountId], references: [id], onDelete: Restrict)

  @@map("whatsapp_channels")
}

model AuthSession {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  tokenHash String   @unique @map("token_hash") @db.Char(64)
  expiresAt DateTime @map("expires_at") @db.Timestamptz(3)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("auth_sessions")
}

model Customer {
  id                      String              @id @default(uuid()) @db.Uuid
  accountId               String              @map("account_id") @db.Uuid
  phoneNumber             String              @map("phone_number") @db.VarChar(20)
  lastOutOfHoursNoticeKey String?             @map("last_out_of_hours_notice_key") @db.VarChar(10)
  createdAt               DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt               DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)
  conversations           Conversation[]
  leads                   Lead[]
  account                 TattooArtistAccount @relation(fields: [accountId], references: [id], onDelete: Restrict)

  @@unique([accountId, phoneNumber])
  @@map("customers")
}

model Conversation {
  id                   String              @id @default(uuid()) @db.Uuid
  accountId            String              @map("account_id") @db.Uuid
  customerId           String              @map("customer_id") @db.Uuid
  flowVersion          FlowVersion         @default(V1) @map("flow_version")
  currentState         ConversationState   @default(START) @map("current_state")
  status               ConversationStatus  @default(ACTIVE)
  selectedSize         TattooSize?         @map("selected_size")
  selectedDetail       DetailLevel?        @map("selected_detail")
  /// Placement in V2; reuse the existing field rather than duplicate it.
  bodyPart             String?             @map("body_part") @db.VarChar(120)
  firstTattoo          Boolean?            @map("first_tattoo")
  sameSizeAsReference  Boolean?            @map("same_size_as_reference")
  targetSizeCm         Float?              @map("target_size_cm") @db.DoublePrecision
  colorDeclaration     ColorDeclaration?   @map("color_declaration")
  v2AnalysisClaimId    String?             @map("v2_analysis_claim_id") @db.Uuid
  v2AnalysisLeaseUntil DateTime?           @map("v2_analysis_lease_until") @db.Timestamptz(3)
  lastActivityAt       DateTime            @default(now()) @map("last_activity_at") @db.Timestamptz(3)
  createdAt            DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)
  customer             Customer            @relation(fields: [customerId], references: [id], onDelete: Cascade)
  lead                 Lead?
  account              TattooArtistAccount @relation(fields: [accountId], references: [id], onDelete: Restrict)

  @@index([accountId, status, lastActivityAt])
  @@index([customerId])
  @@index([status, lastActivityAt])
  @@map("conversations")
}

/// Represents a quotation candidate. Incomplete candidates are preserved when
/// their conversation is abandoned. Only V1 candidates use LeadEvaluation so far.
model Lead {
  id                  String              @id @default(uuid()) @db.Uuid
  accountId           String              @map("account_id") @db.Uuid
  customerId          String              @map("customer_id") @db.Uuid
  conversationId      String?             @unique @map("conversation_id") @db.Uuid
  selectedSize        TattooSize?         @map("selected_size")
  selectedDetail      DetailLevel?        @map("selected_detail")
  /// Consolidated placement from the conversation intake.
  bodyPart            String?             @map("body_part") @db.VarChar(120)
  firstTattoo         Boolean?            @map("first_tattoo")
  sameSizeAsReference Boolean?            @map("same_size_as_reference")
  targetSizeCm        Float?              @map("target_size_cm") @db.DoublePrecision
  colorDeclaration    ColorDeclaration?   @map("color_declaration")
  /// Backend-derived preparation and decision. Decimal measurements are serialized as strings.
  v2Preparation       Json?               @map("v2_preparation") @db.JsonB
  bookingIntent       BookingIntent?      @map("booking_intent")
  status              LeadStatus          @default(ANALYZING)
  reviewReasons       ReviewReason[]      @default([]) @map("review_reasons")
  manualFinalPrice    Decimal?            @map("manual_final_price") @db.Decimal(10, 2)
  calculatedMinPrice  Decimal?            @map("calculated_min_price") @db.Decimal(10, 2)
  calculatedMaxPrice  Decimal?            @map("calculated_max_price") @db.Decimal(10, 2)
  pricingRuleId       String?             @map("pricing_rule_id") @db.Uuid
  pricingRuleVersion  Int?                @map("pricing_rule_version")
  priceSentAt         DateTime?           @map("price_sent_at") @db.Timestamptz(3)
  archivedAt          DateTime?           @map("archived_at") @db.Timestamptz(3)
  createdAt           DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)
  customer            Customer            @relation(fields: [customerId], references: [id], onDelete: Restrict)
  conversation        Conversation?       @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  pricingRule         PricingRule?        @relation(fields: [pricingRuleId], references: [id], onDelete: Restrict)
  images              LeadImage[]
  aiAnalysis          AiAnalysis?
  evaluation          LeadEvaluation?
  account             TattooArtistAccount @relation(fields: [accountId], references: [id], onDelete: Restrict)
  quote               Quote?
  deliveries          WhatsAppDelivery[]

  @@unique([id, accountId])
  @@index([accountId, status, createdAt])
  @@index([customerId])
  @@index([status, createdAt])
  @@index([pricingRuleId])
  @@index([archivedAt])
  @@map("leads")
}

/// Immutable V2 price and the complete inputs/model snapshot that produced it.
model Quote {
  id                       String              @id @default(uuid()) @db.Uuid
  leadId                   String              @unique @map("lead_id") @db.Uuid
  accountId                String              @map("account_id") @db.Uuid
  pricingModelVersionId    String              @map("pricing_model_version_id") @db.Uuid
  amount                   Decimal             @db.Decimal(12, 2)
  currency                 String              @default("PEN") @db.VarChar(3)
  targetAreaCm2            Decimal             @map("target_area_cm2") @db.Decimal(65, 30)
  targetColorCoverage      Decimal             @map("target_color_coverage") @db.Decimal(24, 20)
  detectedStyle            String              @map("detected_style") @db.VarChar(64)
  generalAdjustmentPercent Decimal             @map("general_adjustment_percent") @db.Decimal(7, 2)
  algorithmVersion         String              @map("algorithm_version") @db.VarChar(64)
  snapshot                 Json                @db.JsonB
  createdAt                DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  lead                     Lead                @relation(fields: [leadId, accountId], references: [id, accountId], onDelete: Cascade)
  account                  TattooArtistAccount @relation(fields: [accountId], references: [id], onDelete: Restrict)
  pricingModelVersion      PricingModelVersion @relation(fields: [pricingModelVersionId, accountId], references: [id, accountId], onDelete: Restrict)

  @@unique([leadId, accountId])
  @@index([accountId, createdAt])
  @@map("quotes")
}

/// Durable delivery of V2 result, advance question and handoff confirmation.
model WhatsAppDelivery {
  id            String    @id @default(uuid()) @db.Uuid
  leadId        String    @map("lead_id") @db.Uuid
  accountId     String    @map("account_id") @db.Uuid
  kind          String    @db.VarChar(32)
  payload       Json      @db.JsonB
  claimId       String?   @map("claim_id") @db.Uuid
  leaseUntil    DateTime? @map("lease_until") @db.Timestamptz(3)
  attemptCount  Int       @default(0) @map("attempt_count")
  lastAttemptAt DateTime? @map("last_attempt_at") @db.Timestamptz(3)
  lastErrorCode String?   @map("last_error_code") @db.VarChar(64)
  sentAt        DateTime? @map("sent_at") @db.Timestamptz(3)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  lead          Lead      @relation(fields: [leadId, accountId], references: [id, accountId], onDelete: Cascade)

  @@unique([leadId, kind])
  @@index([accountId, sentAt])
  @@map("whatsapp_deliveries")
}

model LeadEvaluation {
  id               String          @id @default(uuid()) @db.Uuid
  leadId           String          @unique @map("lead_id") @db.Uuid
  rawScore         Int             @map("raw_score")
  maxPositiveScore Int             @map("max_positive_score")
  readinessScore   Decimal         @map("readiness_score") @db.Decimal(5, 2)
  readinessStatus  ReadinessStatus @map("readiness_status")
  rulesVersion     Int             @map("rules_version")
  contributions    Json            @db.JsonB
  blockers         Json            @db.JsonB
  evaluatedAt      DateTime        @default(now()) @map("evaluated_at") @db.Timestamptz(3)
  updatedAt        DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)
  lead             Lead            @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@map("lead_evaluations")
}

model LeadImage {
  id              String    @id @default(uuid()) @db.Uuid
  leadId          String    @map("lead_id") @db.Uuid
  storagePath     String    @map("storage_path") @db.Text
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  deletedAt       DateTime? @map("deleted_at") @db.Timestamptz(3)
  deletedByUserId String?   @map("deleted_by_user_id") @db.Uuid
  lead            Lead      @relation(fields: [leadId], references: [id], onDelete: Cascade)
  deletedBy       User?     @relation("DeletedLeadImages", fields: [deletedByUserId], references: [id], onDelete: Restrict)

  @@index([leadId])
  @@index([deletedAt])
  @@map("lead_images")
}

model AiAnalysis {
  id                        String              @id @default(uuid()) @db.Uuid
  leadId                    String              @unique @map("lead_id") @db.Uuid
  analysisVersion           AnalysisVersion     @default(V1) @map("analysis_version")
  detectedSize              TattooSize?         @map("detected_size")
  sizeConfidence            Decimal?            @map("size_confidence") @db.Decimal(4, 3)
  detectedDetail            DetailLevel?        @map("detected_detail")
  detailConfidence          Decimal?            @map("detail_confidence") @db.Decimal(4, 3)
  style                     String?             @db.VarChar(64)
  styleConfidence           Float?              @map("style_confidence") @db.DoublePrecision
  scaleReferenceType        ScaleReferenceType? @map("scale_reference_type")
  scaleConfidence           Float?              @map("scale_confidence") @db.DoublePrecision
  referenceMainDimensionCm  Float?              @map("reference_main_dimension_cm") @db.DoublePrecision
  referenceAreaCm2          Float?              @map("reference_area_cm2") @db.DoublePrecision
  areaConfidence            Float?              @map("area_confidence") @db.DoublePrecision
  colorCoverage             Float?              @map("color_coverage") @db.DoublePrecision
  colorConfidence           Float?              @map("color_confidence") @db.DoublePrecision
  overallConfidence         Float?              @map("overall_confidence") @db.DoublePrecision
  referenceEssentiallyBlack Boolean?            @map("reference_essentially_black")
  extensiveBodyCoverage     Boolean?            @map("extensive_body_coverage")
  promptVersion             Int?                @map("prompt_version")
  schemaVersion             String?             @map("schema_version") @db.VarChar(64)
  provider                  String?             @db.VarChar(64)
  model                     String?             @db.VarChar(128)
  rawResponse               Json?               @map("raw_response") @db.JsonB
  createdAt                 DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  lead                      Lead                @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@map("ai_analyses")
}

model PricingRule {
  id        String               @id @default(uuid()) @db.Uuid
  accountId String               @map("account_id") @db.Uuid
  size      TattooSize
  detail    DetailLevel
  minPrice  Decimal              @map("min_price") @db.Decimal(10, 2)
  maxPrice  Decimal              @map("max_price") @db.Decimal(10, 2)
  isActive  Boolean              @default(true) @map("is_active")
  version   Int                  @default(1)
  updatedAt DateTime             @updatedAt @map("updated_at") @db.Timestamptz(3)
  leads     Lead[]
  history   PricingRuleHistory[]
  account   TattooArtistAccount  @relation(fields: [accountId], references: [id], onDelete: Restrict)

  @@unique([accountId, size, detail])
  @@index([isActive])
  @@map("pricing_rules")
}

model PricingRuleHistory {
  id              String      @id @default(uuid()) @db.Uuid
  pricingRuleId   String      @map("pricing_rule_id") @db.Uuid
  oldMinPrice     Decimal     @map("old_min_price") @db.Decimal(10, 2)
  oldMaxPrice     Decimal     @map("old_max_price") @db.Decimal(10, 2)
  newMinPrice     Decimal     @map("new_min_price") @db.Decimal(10, 2)
  newMaxPrice     Decimal     @map("new_max_price") @db.Decimal(10, 2)
  changedByUserId String      @map("changed_by_user_id") @db.Uuid
  changedAt       DateTime    @default(now()) @map("changed_at") @db.Timestamptz(3)
  pricingRule     PricingRule @relation(fields: [pricingRuleId], references: [id], onDelete: Restrict)
  changedByUser   User        @relation(fields: [changedByUserId], references: [id], onDelete: Restrict)

  @@index([pricingRuleId, changedAt])
  @@index([changedByUserId])
  @@map("pricing_rule_history")
}

model WhatsAppInboundMessage {
  messageId  String   @id @map("message_id") @db.VarChar(255)
  receivedAt DateTime @default(now()) @map("received_at") @db.Timestamptz(3)

  @@index([receivedAt])
  @@map("whatsapp_inbound_messages")
}
