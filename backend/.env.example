NODE_ENV=development
PORT=3001
FRONTEND_URL=http://localhost:3000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/tatto_flow?schema=public
AI_MODE=mock
AI_MOCK_SIZE=MEDIUM
AI_MOCK_SIZE_CONFIDENCE=0.95
AI_MOCK_DETAIL=DETAILED
AI_MOCK_DETAIL_CONFIDENCE=0.96
SESSION_TTL_HOURS=168
STORAGE_MODE=supabase
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SECRET_KEY=your-backend-only-secret-key
SUPABASE_STORAGE_BUCKET=tattoo-references
TATTOO_ARTIST_EMAIL=tatuador@example.com
TATTOO_ARTIST_PASSWORD=clave-123-desarrollo
WHATSAPP_ACCESS_TOKEN=replace-with-system-user-token
WHATSAPP_PHONE_NUMBER_ID=replace-with-phone-number-id
WHATSAPP_BUSINESS_ACCOUNT_ID=replace-with-business-account-id
WHATSAPP_VERIFY_TOKEN=replace-with-private-verify-token
META_APP_SECRET=replace-with-meta-app-secret
WHATSAPP_GRAPH_API_VERSION=vXX.X
